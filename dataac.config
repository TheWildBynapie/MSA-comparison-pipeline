workflow.output.mode = 'copy'
/*
* Default parameters for the workflow.
*/
params {
    sources = [
        //"data/raw/animalCytochromeNcbi.fasta:cytochrome c oxidase subunit I",
        // "data/raw/animalsHistoneH3.fasta:histone H3",
        // "data/raw/bacteriaBetaLactamaseSwissProt.fasta:beta-lactamase",
        // "data/raw/bacteriaRpoB.fasta:RpoB|RNA polymerase subunit beta",
        // "data/raw/eukaHistoneH4.fasta:histone H4",
        "data/raw-ncbi/eukaP53.fasta:cellular tumor antigen p53",
        // "data/raw/mammalFullHistoneH3onlyNcbi.fasta:histone H3",
        // "data/raw/mammalGrowthHormoneNcbi.fasta:growth hormone",
        // "data/raw/mammalMHConlyNcbi.fasta:MHC|major histocompatibility complex",
        // "data/raw/virusHIVenv.fasta:envelope| env ",
        // "data/raw/virusInfluenzaHemagglutinin.fasta:Hemagglutinin",
        // "data/raw/virusRdRp.fasta:RdRp|RNA-dependent RNA polymerase",
        ]
    sampleSize = 50
}

profiles {
    test{
        params.sources = [
            "data/raw/bacteriaBetaLactamaseSwissProt_cleaned.fasta:beta-lactamase",
        ]
        params.sampleSize = 50
    }

    cox1{
        params.sources = [
            "data/cox1/octopuscox1blastp5000animalsOnly_PID70to80.fasta:cytochrome c oxidase subunit 1",
        ]
        params.sampleSize = 50
    }    
}