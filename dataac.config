workflow.output.mode = 'copy'
/*
* Default parameters for the workflow.
*/
params {
    sources = [
        "animalCytochromeNcbi.fasta:cytochrome c oxidase subunit I",
        "animalsHistoneH3.fasta:histone H3",
        "bacteriaBetaLactamaseSwissProt.fasta:beta lactamase",
        "bacteriaRpoB.fasta:RpoB",
        "eukaHistoneH4.fasta:histone H4",
        "eukaP53.fasta:p53",
        //"mammalFullHistoneH3onlyNcbi.fasta:histone H3",
        //"mammalGrowthHormoneNcbi.fasta:growth hormone",
        //"mammalMHConlyNcbi.fasta:MHC|major histocompatibility complex",
        "virusHIVenv.fasta:HIV env",
        "virusInfluenzaHemagglutinin.fasta:influenza hemagglutinin",
        "virusRdRp.fasta:RdRp|RNA-dependent RNA polymerase",
        ]
    sampleSize  = 50
}