workflow.output.mode = 'copy'
/*
* Default parameters for the workflow.
*/
params {
    sources = [
            "data/cox1/corglcox1blastp5000bacteriaOnly.csv:cytochrome c oxidase subunit 1:585",
            "data/cox1/humancox1blastp5000mammalOnly.csv:cytochrome c oxidase subunit 1:514",
            "data/cox1/lampreycox1blastp5000chordatesOnly.csv:cytochrome c oxidase subunit 1:518",
            "data/cox1/octopuscox1blastp5000animalsOnly.csv:cytochrome c oxidase subunit 1:210",
            "data/cox1/ricecox1blastp5000eukaOnly.csv:cytochrome c oxidase subunit 1:525",
            "data/I80ADvirusRDRP/I80ADvirusRDRPblast5000.csv:RNA-directed RNA polymerase|RNA-dependent RNA polymerase|RdRp:758",
            "data/nt-tests/lampreycox1ntblast5000chordatesOnly.csv:cytochrome c oxidase subunit 1:1555",
        ]
    ranges = [
        "0:20",
        "20:40",
        "40:60",
        "50:70",
        "60:80",
        "70:90",
        "80:100",
    ]
    sampleSize = 50
    minSeqCount = 10
}

profiles {
    test{
        params.sources = [
            "data/raw/bacteriaBetaLactamaseSwissProt_cleaned.fasta:beta-lactamase",
        ]
    }

    cox1{
        params.sources = [
            "data/cox1/octopuscox1blastp5000animalsOnly_PID70to80.fasta:cytochrome c oxidase subunit 1",
        ]
    }    
}