workflow.output.mode = 'copy'
// docker {
//     enabled = true
//     runOptions = '-u \$(id -u):\$(id -g)' // optional, helps avoid permission issues with output files
// }
/*
* Default parameters for the workflow.
*/
params {
    inputs = ['testdata/test.fasta', 'testdata/test_gapless.fasta']
    runs = [
        'mafft_auto:mafft:mafft --auto', 
        'mafft_linsi:mafft:linsi',
        'muscle:muscle:-align', 
        'kalign:kalign:', 
        't_coffee:t_coffee:', 
        'probcons:probcons:', 
        'clustalw:clustalw:', 
        'clustalo:clustalo:', 
        'amap:amap:', 
        'prank:prank:', 
        'fsa:fsa:',
        'muscle3.8:muscle3.8:',
        'famsa:famsa:',
        // 'pagan:pagan:',
        // 'pasta:pasta:',
        'bali-phy:bali-phy:--iterations=20',
        //'magus:magus:'
    ]
}

profiles {
    blastSeqtk{
        params.inputs = ['data/blastSeqtk.fasta'] 
    }
    mammalHistoneH3{
        params.inputs = ['data/mammalFullHistoneH3onlyNcbi50seq.fasta'] 
    }
    mammalGrowthHormone{
        params.inputs = ['data/mammalGrowthHormoneNcbi50seq.fasta'] 
    }
    mammalMHC{
        params.inputs = ['data/mammalMHConlyNcbi50seq.fasta'] 
    }

    all50seqs{
        params.inputs = ['data/mammalFullHistoneH3onlyNcbi50seq.fasta', 'data/mammalGrowthHormoneNcbi50seq.fasta', 'data/mammalMHConlyNcbi50seq.fasta'] 
    }
}