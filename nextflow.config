/*
* Default parameters for the workflow.
*/
workflow.output.mode = 'copy'
params {
    inputs = [
        'testdata/test.fasta', 
        'testdata/test_gapless.fasta:testdata/test_reference.fasta'
        ]
    runs = [
        'mafft_auto:mafft:mafft --auto', 
        'muscle:muscle:-align', 
        'kalign:kalign:', 
        't_coffee:t_coffee:', 
        'probcons:probcons:', 
        'clustalw:clustalw:', 
        'clustalo:clustalo:', 
        'amap:amap:', 
        'prank:prank:', 
        'fsa:fsa:',
        'muscle3.8:muscle3.8:',
        'famsa:famsa:',
        'bali-phy:bali-phy:--iterations=20',
    ]
}

profiles {
    /*
    * Runs for testing
    */
    smallrun{
        params.inputs = ['testdata/test_gapless.fasta:testdata/test_reference.fasta']
        params.runs = [
            'mafft_auto:mafft:mafft --auto', 
            'muscle:muscle:-align',
            'clustalo:clustalo:', 
            'prank:prank:', 
        ]   
    }
    smallishrun{
        params.inputs = ['testdata/paganExampleReads.fas']
        params.runs = [
            'mafft_auto:mafft:mafft --auto', 
            'muscle:muscle:-align',
            'clustalo:clustalo:', 
            'prank:prank:', 
        ]   
    }

    /*
    * Runs for NCBI data sets
    */
    mammals{
        params.inputs = [
         'data/50seqs/mammalFullHistoneH3onlyNcbi50seq.fasta',
         'data/50seqs/mammalGrowthHormoneNcbi50seq.fasta',
         'data/50seqs/mammalMHConlyNcbi50seq.fasta',
         ] 
    }
    animals{
        params.inputs = [
         'data/50seqs/animalCytochromeNcbi_50seq.fasta',
         'data/50seqs/animalsHistoneH3_50seq.fasta',
         ] 
    }
    eukaryotes{
        params.inputs = [
         'data/50seqs/eukaHistoneH4_50seq.fasta',
         'data/50seqs/eukaP53_50seq.fasta',
         ] 
    }
    bacteria{
        params.inputs = [
         'data/50seqs/bacteriaRpoB_50seq.fasta',
         'data/50seqs/bacteriaBetaLactamase_modified50seq.fasta'
         ] 
    }
    viruses{
        params.inputs = [
         'data/50seqs/virusHIVenv_50seq.fasta',
         'data/50seqs/virusInfluenzaHemagglutinin_50seq.fasta',
         'data/50seqs/virusRdRp_50seq.fasta'
         ]
        params.runs = [
            //no t-coffee or bali-phy for viruses, as they break
            'mafft_auto:mafft:mafft --auto', 
            'muscle_super5:muscle:-super5', 
            'kalign:kalign:', 
            'probcons:probcons:', 
            'clustalw:clustalw:', 
            'clustalo:clustalo:', 
            'amap:amap:', 
            'prank:prank:', 
            'fsa:fsa:',
            'muscle3.8:muscle3.8:',
            'famsa:famsa:-medoidtree',
        ] 
    }
    all50seqs{
        params.inputs = [
         'data/50seqs/mammalFullHistoneH3onlyNcbi50seq.fasta',
         'data/50seqs/mammalGrowthHormoneNcbi50seq.fasta',
         'data/50seqs/mammalMHConlyNcbi50seq.fasta',
         'data/50seqs/animalCytochromeNcbi_50seq.fasta',
         'data/50seqs/animalsHistoneH3_50seq.fasta',
         'data/50seqs/modified_sequences.fasta',
         'data/50seqs/bacteriaRpoB_50seq.fasta',
         'data/50seqs/eukaHistoneH4_50seq.fasta',
         'data/50seqs/virusHIVenv_50seq.fasta',
         'data/50seqs/virusInfluenzaHemagglutinin_50seq.fasta',
         'data/50seqs/virusRdRp_50seq.fasta'
         ] 
    }

    /*
    * Runs for blast data sets
    */
    blasthuman{
        params.inputs = [
            'data/50seqsblast/human/',
        ]
    }
    blastlamprey{
        params.inputs = [
            'data/50seqsblast/lamprey/',
        ]
    }
    blastoctopus{
        params.inputs = [
            'data/50seqsblast/octopus/',
        ]
    }
    blastrice{
        params.inputs = [
            'data/50seqsblast/rice/',
        ]
    }
    blastcorgl{
        params.inputs = [
            'data/50seqsblast/corgl/',
        ]
    }

    /*
    * Runs for simulated data sets
    */
    alisim1{
        params.inputs = ['data/alisim1/alignment.unaligned.fa:data/alisim1/alignment.fa']
    }

    /*
    * Runs for testing internal aligner differences based on parameters and modes
    */
    mafft{
        params.runs = [
            'mafft_auto:mafft:mafft --auto', 
            'linsi:mafft:linsi', 
            'ginsi:mafft:ginsi', 
            'einsi:mafft:einsi', 
            'fftnsi:mafft:fftnsi',
            'fftnsi_extra_iters:mafft:mafft --retree 2 --maxiterate 1000',
            'fftns:mafft:fftns', 
            'fftns_extrafast:mafft:mafft --retree 1 --maxiterate 0',
            'nwnsi:mafft:nwnsi', 
            'nwns:mafft:nwns',
            'parttree:mafft:mafft --retree 1 --maxiterate 0 --nofft --parttree',
            'dpparttree:mafft:mafft --retree 1 --maxiterate 0 --nofft --dpparttree',

            'muscle:muscle:-align', //these 4 for 'control' - well its the bestish we can get with everything being relative
            'fsa:fsa:',
            'prank:prank:',
            'kalign:kalign:', 
        ]
    }

    clustalo{
        params.runs = [
            'default:clustalo:',
            'auto:clustalo:--auto',
            'full:clustalo:--full',
            'full_iter:clustalo:--full-iter',
            'iter10:clustalo:--iter=10',
            'guidetree_iter10:clustalo:--max-guidetree-iterations=10',
            'hmm_iter10:clustalo:--max-hmm-iterations=10',

            'muscle:muscle:-align', //these 4 for 'control' - well its the bestish we can get with everything being relative
            'fsa:fsa:',
            'prank:prank:',
            'kalign:kalign:', 
        ]
    }

    muscle{
        params.runs = [
            'muscle:muscle:-align', 
            'super5:muscle:-super5',

            'mafft:mafft:mafft --auto', //these 4 for 'control' - well its the bestish we can get with everything being relative
            'fsa:fsa:',
            'prank:prank:',
            'kalign:kalign:', 
        ]
    }
}