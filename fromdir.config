/*
* Default parameters for the workflow.
*/
workflow.output.mode = 'copy'
params {
    msaDirs = [
            'results/MSA_outputs/test',
            'results/MSA_outputs/test_gapless'
        ]
}

profiles {
    /*
    * Runs for testing
    */
    smallrun{
        params.msaDirs = [
            'results/MSA_outputs/smalldir'
        ]
    }
    /*
    * Runs for NCBI data sets
    */
}